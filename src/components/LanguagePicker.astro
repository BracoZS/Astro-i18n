---
import { LOCALE_CODES, localizeUrl } from '../i18n';
---
<ul class="language-picker" aria-label="Language selector">
  {LOCALE_CODES.map((lang) => (
    <li>
      <a href={localizeUrl(Astro.url, lang)}>{lang}</a>
    </li>
  ))}
</ul>

<style>
  .language-picker {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: #394150;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  a:hover {
    color: #1d2433;
  }
</style>
